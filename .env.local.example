# ============================================================
# КРЕМЛЬ — Variáveis de ambiente (Vercel)
# Copie este arquivo para .env.local e preencha com suas chaves
# (ou use `vercel env pull` após `vercel link`)
# ============================================================

# Acesso ao painel (deve coincidir com ALLOWED_CODES em assets/js/auth.js)
KREMLIN_ACCESS_CODE=0502026

# Vercel Blob (binários / uploads)
BLOB_READ_WRITE_TOKEN=

# Vercel KV (metadados + notas Tiptap)
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=